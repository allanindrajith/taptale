{
  "expo": {
    "name": "taptale",
    "slug": "taptale",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taptale",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.allanindrajith.taptale",
      "usesAppleSignIn": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TapTale uses your location to calculate real-time distance and travel time to heritage spots across Lithuania.",
        "NFCReaderUsageDescription": "TapTale uses NFC to scan physical heritage plaques at monuments across Lithuania to unlock historical stories and passes.",
        "NSCameraUsageDescription": "TapTale uses the camera so you can take a profile photo.",
        "NSPhotoLibraryUsageDescription": "TapTale uses your photo library so you can choose a profile photo.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["comgooglemaps", "waze", "uber", "bolt"]
      }
    },
    "android": {
      "package": "com.allanindrajith.taptale",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.NFC"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-asset",
      "./plugins/with-map-app-queries",
      "react-native-nfc-manager",
      [
        "expo-image-picker",
        {
          "photosPermission": "TapTale uses your photo library so you can choose a profile photo.",
          "cameraPermission": "TapTale uses the camera so you can take a profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2ed7dd90-7c96-4e3b-8755-27befed39293"
      }
    },
    "owner": "allanindrajith"
  }
}
